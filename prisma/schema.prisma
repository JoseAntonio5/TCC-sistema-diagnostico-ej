generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "mysql"
}

model diagnostico {
  id                   Int        @id @default(autoincrement())
  createdAt            DateTime   @default(now())
  empresaId            Int
  nivelMaturidade      String
  notaGeral            Float
  percentualMaturidade Float
  porDimensao          Json
  porDiretoria         Json
  empresa              empresa    @relation(fields: [empresaId], references: [id], map: "Diagnostico_empresaId_fkey")
  resposta             resposta[]

  @@index([empresaId], map: "Diagnostico_empresaId_idx")
}

model empresa {
  id          Int           @id @default(autoincrement())
  nome        String
  createdAt   DateTime      @default(now())
  diagnostico diagnostico[]
}

model resposta {
  id            Int         @id @default(autoincrement())
  diagnosticoId Int
  perguntaId    Int
  codigo        String
  diretoria     String
  dimensao      String
  texto         String      @db.Text
  valor         Int
  diagnostico   diagnostico @relation(fields: [diagnosticoId], references: [id], map: "Resposta_diagnosticoId_fkey")

  @@index([diagnosticoId], map: "Resposta_diagnosticoId_idx")
}
